# --- Python virtual environments and caches (never commit) ---
# venv/ also has its own .gitignore, but keep this here so a stray file or a
# newly created environment can never be committed by accident.
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]

# --- Streamlit secrets ----------------------------------------
# Never commit these: enter the values in the Cloud app's Secrets settings.
**/.streamlit/secrets.toml
