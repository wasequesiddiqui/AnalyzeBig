# ============================================================
# TEMPLATE — copy this file to `secrets.toml` in this same folder,
# fill in the real values, then paste the SAME text into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# ============================================================
# `secrets.toml` is gitignored and must never be committed.
# This `secrets.toml.example` file holds no secrets and is safe to commit.
#
# How the values reach the code:
#     secrets.toml -> st.secrets -> _load_secrets_into_env() in Home.py
#                  -> os.environ -> os.getenv("DEEPSEEK_API_KEY") etc.
#
# KEY NAMES ARE ENVIRONMENT VARIABLE NAMES, so they must match the code exactly:
#   * upper-case, no quotes around the key name
#   * values are always quoted strings
#   * no [sections] — only top-level keys are mirrored into the environment
#   * a syntax error anywhere makes Streamlit reject the WHOLE file, so every
#     key goes missing, not just the broken line
#
# TIP: if you do NOT use a feature, DELETE its optional keys rather than leaving
# placeholders. A placeholder is a non-empty string, so it passes the app's
# "is it set?" guard and then fails later with a confusing 401 or permission
# error; a missing key produces a clear "Missing X" message instead.

# --- Required: LLM used by every agent ------------------------
# Get this from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Required: news headlines + sentiment ---------------------
# Get this from https://newsapi.org/account (free developer tier)
NEWS_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Optional: "Save Analysis" (Chroma Cloud knowledge base) ---
# Both OPENAI_API_KEY and CHROMA_API_KEY are needed for the Save button.
# CHROMA_TENANT is an ID, not a secret. The other three have working defaults,
# so they only need setting if you use a non-default host/database.
# OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# CHROMA_API_KEY = "ck-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# CHROMA_TENANT = "your-tenant-id"
# CHROMA_DATABASE = "StockAnalytics"
# CHROMA_HOST = "api.trychroma.com"

# --- Optional: crewAI tuning ----------------------------------
# CREWAI_MODEL = "deepseek/deepseek-chat"
# CREWAI_MAX_ITER = "8"
